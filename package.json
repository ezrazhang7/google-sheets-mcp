{
  "name": "google-sheets-mcp",
  "version": "0.2.1",
  "description": "MCP server for Google Sheets: read, edit, append, insert/delete rows and columns, and write formulas in place",
  "main": "dist/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "pack": "npm run build && mcpb pack . google-sheets.mcpb",
    "mint-token": "npm run build && node dist/node/mintToken.js",
    "deploy": "wrangler deploy",
    "dev:worker": "wrangler dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezrazhang7/google-sheets-mcp.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ezrazhang7/google-sheets-mcp/issues"
  },
  "homepage": "https://github.com/ezrazhang7/google-sheets-mcp#readme",
  "type": "module",
  "bin": {
    "google-sheets-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.120.0"
  }
}
